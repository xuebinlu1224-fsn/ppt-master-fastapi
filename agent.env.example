# ppt-master-agent runtime config
# Copy this file to `agent.env` and fill in real values. `agent.env` is
# git-ignored and must never be committed (it carries API keys).
#
# Two-env rule (see AGENTS.md):
#   * DEEPSEEK_* below is read by the OUTER service (app.py) for
#     /tasks/{task_id}/agent-plan.
#   * IMAGE_BACKEND / AGNES_* / OPENAI_* / GEMINI_* is read by the
#     inner ppt-master scripts (image_gen.py etc.) for image
#     generation. The compose file also forwards these into the
#     process environment so ppt-master's .env loader picks them up
#     even though the image ships without a ppt-master/.env.

# ---- DeepSeek (outer service) ----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- Python interpreter for ppt-master scripts ----
# Override which `python` runs the vendored ppt-master scripts
# (image_gen.py, project_manager.py, exporter.py, ...). REQUIRED when the
# outer service's .venv is Python < 3.10: ppt-master scripts use PEP 604
# union syntax (`X | None`, `list[str] | None`) and will fail with
# `TypeError: unsupported operand type(s) for |` under 3.9.
#
# Set this to any Python 3.10+ on PATH. Examples:
#   macOS (Homebrew / uv): /Users/you/.local/bin/python3.12
#   Linux:                 /usr/bin/python3.11
#   Docker:                leave empty — the image ships with Python 3.12.
# Leave commented out / empty to auto-resolve from project venvs / PATH.
# PPTMASTER_PYTHON_BIN=/Users/you/.local/bin/python3.12

# ---- Image backend (ppt-master scripts) ----
# Pick one. Set IMAGE_BACKEND and the matching *_API_KEY.
IMAGE_BACKEND=agnes
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-image-2.1-flash

# Example for an OpenAI-compatible backend:
# IMAGE_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-image-1
